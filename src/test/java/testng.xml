<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Selenium Cross Browser Suite" parallel="tests" thread-count="3">

    <!-- TEST 1: CHROME BROWSER -->
    <test name="Chrome Test Execution">
        <parameter name="browser" value="chrome" />
        <classes>
            <class name="parallelTest.SeleniumCrossbrowserTest" />
        </classes>
    </test>

    <!-- TEST 2: FIREFOX BROWSER -->
    <test name="Firefox Test Execution">
        <parameter name="browser" value="firefox" />
        <classes>
            <class name="parallelTest.SeleniumCrossbrowserTest" />
        </classes>

    </test>

    <!-- TEST 3: EDGE BROWSER -->
    <test name="Edge Test Execution">
        <parameter name="browser" value="edge" />
        <classes>
            <class name="parallelTest.SeleniumCrossbrowserTest" />
        </classes>


    </test>

</suite>
